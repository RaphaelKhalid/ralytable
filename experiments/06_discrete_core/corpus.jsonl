{"steps": [{"id": 1, "deps": [], "text": "Total marbles = 4 + 3 + 5 = 12."}, {"id": 2, "deps": [], "text": "Ways to choose 3 from 12 = C(12,3) = 220."}, {"id": 3, "deps": [1, 2], "text": "Favorable ways = C(4,3) + C(3,3) + C(5,3) = 4 + 1 + 10 = 15."}, {"id": 4, "deps": [3], "text": "Probability = 15 / 220 = 3/44."}], "answer": "3/44"}
{"steps": [{"id": 1, "deps": [], "text": "Total outcomes = 6 \u00d7 6 = 36."}, {"id": 2, "deps": [], "text": "Pairs summing to 7: (1,6),(2,5),(3,4),(4,3),(5,2),(6,1) \u2192 6 pairs."}, {"id": 3, "deps": [1, 2], "text": "Probability = 6 / 36."}, {"id": 4, "deps": [3], "text": "Simplify to 1/6."}], "answer": "1/6"}
{"steps": [{"id": 1, "deps": [], "text": "Total ways to choose 5 from 10 = C(10,5) = 252."}, {"id": 2, "deps": [], "text": "Ways to choose 3 men from 6 = C(6,3) = 20."}, {"id": 3, "deps": [1, 2], "text": "Ways to choose 2 women from 4 = C(4,2) = 6."}, {"id": 4, "deps": [3], "text": "Favorable = 20 \u00d7 6 = 120, so probability = 120/252 = 10/21."}], "answer": "10/21"}
{"steps": [{"id": 1, "deps": [], "text": "Total permutations = 52!."}, {"id": 2, "deps": [], "text": "Fix top as ace (4 choices) and bottom as king (4 choices)."}, {"id": 3, "deps": [1, 2], "text": "Remaining 50 cards can be arranged in 50! ways."}, {"id": 4, "deps": [3], "text": "Probability = (4 \u00d7 4 \u00d7 50!) / 52! = 16 / (52 \u00d7 51) = 16/2652 = 4/663."}], "answer": "4/663"}
{"steps": [{"id": 1, "deps": [], "text": "Total codes = P(10,4) = 10 \u00d7 9 \u00d7 8 \u00d7 7 = 5040."}, {"id": 2, "deps": [], "text": "Codes without digit 7 = P(9,4) = 9 \u00d7 8 \u00d7 7 \u00d7 6 = 3024."}, {"id": 3, "deps": [1, 2], "text": "Codes with 7 = 5040 \u2212 3024 = 2016."}, {"id": 4, "deps": [3], "text": "Probability = 2016 / 5040 = 2/5."}], "answer": "2/5"}
{"steps": [{"id": 1, "deps": [], "text": "Total outcomes = 2^5 = 32."}, {"id": 2, "deps": [], "text": "Ways to choose 2 heads out of 5 = C(5,2) = 10."}, {"id": 3, "deps": [1, 2], "text": "Probability = 10 / 32."}, {"id": 4, "deps": [3], "text": "Simplify to 5/16."}], "answer": "5/16"}
{"steps": [{"id": 1, "deps": [], "text": "Total ordered selections = P(8,3) = 8 \u00d7 7 \u00d7 6 = 336."}, {"id": 2, "deps": [], "text": "If Alice is president, then choose 2 more from the remaining 7 in order: P(7,2) = 7 \u00d7 6 = 42."}, {"id": 3, "deps": [1, 2], "text": "Probability = 42 / 336."}, {"id": 4, "deps": [3], "text": "Simplify to 1/8."}], "answer": "1/8"}
{"steps": [{"id": 1, "deps": [], "text": "Total ways to draw 2 from 10 = C(10,2) = 45."}, {"id": 2, "deps": [], "text": "Ways to draw 1 red and 1 black = 5 \u00d7 5 = 25."}, {"id": 3, "deps": [1, 2], "text": "Probability = 25 / 45."}, {"id": 4, "deps": [3], "text": "Simplify to 5/9."}], "answer": "5/9"}
